#define ZMK_POINTING_DEFAULT_MOVE_VAL 800  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 400    // default: 20

#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv { acceleration-exponent = <0>; };

&glidepoint_rh_listener { input-processors = <&zip_xy_scaler 3 3>; };

&glidepoint_rh_listener {
    scroller {
        //layers = <1 3>;

        layers = <3>;
        input-processors =
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_scaler (-1) 1>;
    };
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        win: os_win {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "WIN";
            toggle-mode = "on";
        };

        mac: os_mac {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "MAC";
            toggle-mode = "off";
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        bluetooth {
            bindings = <&mo 6>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q           &kp W           &kp E             &kp R         &kp T         &kp Y         &kp U       &kp I              &kp O            &kp P
  &hm LEFT_WIN A  &hm LEFT_ALT S  &hm LEFT_SHIFT D  &hm LEFT_WIN F  &kp G       &kp H         &hm RIGHT_GUI J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RIGHT_GUI SEMI
  &kp Z           &kp X           &kp C             &kp V         &kp B         &kp N         &kp M       &kp COMMA          &kp DOT          &kp FSLH
  &trans          &trans          &kp TAB           &mo 4         &lt 2 SPACE   &lt 3 SPACE   &mo 5       &mt RALT ENTER     &trans           &trans
            >;
        };

        win {
            bindings = <
  &kp Q           &kp W           &kp E             &kp R         &kp T         &kp Y         &kp U       &kp I              &kp O            &kp P
  &hm LCTRL A     &hm LEFT_ALT S  &hm LEFT_SHIFT D  &hm LCTRL F     &kp G       &kp H         &hm RCTRL J      &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RCTRL SEMI
  &kp Z           &kp X           &kp C             &kp V         &kp B         &kp N         &kp M       &kp COMMA          &kp DOT          &kp FSLH
  &trans          &trans          &kp TAB           &mo 4         &lt 2 SPACE   &lt 3 SPACE   &mo 5       &mt RWIN ENTER     &trans           &trans
            >;
        };

        function {
            bindings = <
  &kp F1     &kp F2    &kp F3         &kp F4         &kp F5        &kp F6        &kp F7        &kp F8         &kp F9         &kp F10
  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_WIN   &kp TAB       &kp TAB       &kp RIGHT_GUI &kp RIGHT_SHIFT &kp RIGHT_ALT  &kp RIGHT_GUI
  &kp F8     &kp F9    &kp F10        &kp F11        &kp F12       &none         &none         &none          &none          &none
  &trans     &trans    &trans         &trans         &trans        &trans        &trans        &trans         &trans         &trans
            >;
        };

        row {
            bindings = <
  &none      &none      &none         &none          &none         &kp INS       &kp PG_UP     &kp UP         &kp PG_DN      &kp LS(LG(S))
  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_WIN   &kp TAB       &kp BSPC      &kp LEFT      &kp DOWN       &kp RIGHT      &kp LS(LG(N4))
  &none      &none      &none         &none          &none         &kp DEL       &kp HOME      &kp LSHFT      &kp END        &kp LSHFT
  &trans     &trans     &trans        &trans         &trans        &trans        &trans        &trans         &trans         &trans
            >;
        };

        number {
            bindings = <
  &kp N1     &kp N2    &kp N3         &kp N4         &kp N5        &kp N7        &kp N8        &kp N9         &kp ASTRK      &kp SLASH
  &kp N6     &kp N7    &kp N8         &kp N9         &kp N0        &kp N4        &kp N5        &kp N6         &kp PLUS       &kp MINUS
  &none      &none     &none          &none          &none         &kp N1        &kp N2        &kp N3         &kp DOT        &kp COMMA
  &trans     &trans    &trans         &trans         &trans        &trans        &kp N0        &trans         &trans         &trans
            >;
        };

        simbol {
            bindings = <
  &kp EXCL   &kp AT    &kp LBKT       &kp RBKT       &kp PRCNT     &kp PIPE      &kp BSLH      &kp SLASH      &kp ASTRK      &kp QMARK
  &kp HASH   &kp DLLR  &kp LPAR       &kp RPAR       &kp CARET     &kp GRAVE     &kp EQUAL     &kp MINUS      &kp PLUS       &kp COLON
  &none      &none     &kp LBRC       &kp RBRC       &kp AMPS      &kp TILDE     &kp UNDER     &kp LT         &kp GT         &kp DQT
  &trans     &trans    &trans         &trans         &trans        &trans        &trans        &trans         &trans         &trans
            >;
        };

        adjust {
            bindings = <
  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR_ALL  &bt BT_CLR    &none         &none         &win 1        &mac 1         &none          &none
  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4  &none         &mkp LCLK     &mkp MCLK      &mkp RCLK      &none
  &none         &none         &none           &none         &none         &none         &kp C_VOL_UP  &kp K_MUTE     &kp C_VOL_DN   &none
  &trans        &trans        &trans          &mo 7         &studio_unlock  &studio_unlock  &none       &trans         &trans         &trans
            >;
        };

        mouse {
            bindings = <
  &studio_unlock  &mkp MCLK       &mkp LCLK       &mkp RCLK     &kp CAPS         &none           &mkp MCLK       &mkp LCLK     &mkp RCLK        &none
  &none           &mkp MCLK       &mkp LCLK       &mkp RCLK     &none            &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
  &none           &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
  &none           &none           &kp TAB         &kp SPACE     &to 0            &kp BACKSPACE   &kp ENTER       &kp ESC       &none            &none
            >;
        };
    };
};
